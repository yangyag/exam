# 로컬 설정 템플릿. 아래처럼 복사한 뒤 값을 채우세요. (.env 는 git 에 들어가지 않습니다)
#
#   cp .env.example .env
#
# EXAM_DB_URL 을 설정하면 tools/load_db.py 가 이 값으로 접속합니다.
# 설정하지 않으면 DATABASE_URL > libpq PG* 환경변수 > 기본값 순으로 찾습니다.

EXAM_DB_URL=postgresql://yangyag:<비밀번호>@localhost:5432/app

# EC2 예시
# EXAM_DB_URL=postgresql://yangyag:<비밀번호>@127.0.0.1:5432/app
