# 프론트 이미지 (Nuxt SPA 정적 파일 + nginx).
#   빌드: 저장소 루트에서
#     docker build --platform linux/amd64 -f deploy/Dockerfile.front -t exam-front:1.0 .
# nuxt generate 로 정적 파일을 만들고, nginx 가 정적 서빙과 함께
# /api·/figures 를 백엔드 컨테이너로 프록시한다(같은 오리진 → CORS 불필요).
FROM node:22-alpine AS build

WORKDIR /app

COPY front/package.json front/package-lock.json ./
RUN npm ci

COPY front/ ./

# 같은 오리진 배포이므로 API base 를 비워 상대 경로(/api/...)로 호출하게 한다
ENV NUXT_PUBLIC_API_BASE=""
RUN npm run generate

FROM nginx:alpine

COPY deploy/front-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.output/public /usr/share/nginx/html

EXPOSE 80
